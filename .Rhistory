knitr::opts_chunk$set(echo = TRUE)
library(nycflights13)
library(palmerpenguins)
library(repurrrsive)
library(tidyverse)
library(testthat)
library(digest)
fix_me <- tribble(
~province,             ~cities,
"BC",                  "Victoria",
"Alberta",             "Edmonton",
"SK",                  "Regina",
"British Columbia",    "Vancouver",
"Alberta",             "Calgary",
"BC",                  "Kelowna",
"AB",                  "Lethbridge",
"SK",                  "Saskatoon"
)
fixed <- NULL
fixed
fix_me <- tribble(
~province,             ~cities,
"BC",                  "Victoria",
"Alberta",             "Edmonton",
"SK",                  "Regina",
"British Columbia",    "Vancouver",
"Alberta",             "Calgary",
"BC",                  "Kelowna",
"AB",                  "Lethbridge",
"SK",                  "Saskatoon"
)
fixed <- fix_me |>
mutate(
province = case_when(
province == "Alberta" ~ "AB",
province == "British Columbia" ~ "BC",
TRUE ~ province
)
)
fixed
# TESTS
test_that("fixed is a data frame with the correct dimensions", {
expect_true(is.data.frame(fixed))
expect_equal(nrow(fixed), 8)
expect_equal(ncol(fixed), 2)
})
test_that("fixed has the correct column names", {
expect_setequal(colnames(fixed), c("province", "cities"))
})
test_that("province values have been standardized to abbreviations", {
expect_setequal(unique(fixed$province), c("BC", "AB", "SK"))
})
test_that("cities values are unchanged", {
expect_setequal(
fixed$cities,
c("Victoria", "Edmonton", "Regina", "Vancouver",
"Calgary", "Kelowna", "Lethbridge", "Saskatoon")
)
})
penguins_less_nas  <- penguins |>
drop_na(body_mass_g)
penguins_less_nas
# TESTS
test_that("penguins_less_nas is a data frame with the correct dimensions", {
expect_true(is.data.frame(penguins_less_nas))
expect_equal(nrow(penguins_less_nas), 342)
expect_equal(ncol(penguins_less_nas), 8)
})
test_that("penguins_less_nas has the correct column names", {
expect_setequal(
tolower(colnames(penguins_less_nas)),
c("species", "island", "bill_length_mm", "bill_depth_mm",
"flipper_length_mm", "body_mass_g", "sex", "year")
)
})
test_that("body_mass_g has no NAs and sums to the expected value", {
expect_false(any(is.na(penguins_less_nas$body_mass_g)))
expect_equal(sum(penguins_less_nas$body_mass_g), 1437000, tolerance = 1.5e-08)
})
penguins_no_nas <- penguins |>
drop_na()
penguins_no_nas
# TESTS
test_that("penguins_no_nas is a data frame with the correct dimensions", {
expect_true(is.data.frame(penguins_no_nas))
expect_equal(nrow(penguins_no_nas), 333)
expect_equal(ncol(penguins_no_nas), 8)
})
test_that("penguins_no_nas has the correct column names", {
expect_setequal(
tolower(colnames(penguins_no_nas)),
c("species", "island", "bill_length_mm", "bill_depth_mm",
"flipper_length_mm", "body_mass_g", "sex", "year")
)
})
test_that("penguins_no_nas has no NAs and body_mass_g sums to the expected value", {
expect_false(any(is.na(penguins_no_nas)))
expect_equal(sum(penguins_no_nas$body_mass_g), 1400950, tolerance = 1.5e-08)
})
engine_summary <- planes |>
group_by(engine) |>
summarise(
avg_seats = mean(seats, na.rm = TRUE),
planes = n()
)
engine_summary
# TESTS
test_that("engine_summary is a data frame with the correct dimensions", {
expect_true(is.data.frame(engine_summary))
expect_equal(nrow(engine_summary), 6)
expect_equal(ncol(engine_summary), 3)
})
test_that("engine_summary has the correct column names", {
expect_setequal(tolower(colnames(engine_summary)), c("engine", "avg_seats", "planes"))
})
test_that("engine_summary has the correct summary values", {
expect_equal(sum(engine_summary$avg_seats), 365.4726, tolerance = 1.5e-07)
expect_equal(sum(engine_summary$planes), 3322, tolerance = 1.5e-08)
})
knitr::opts_chunk$set(echo = TRUE)
library(testthat)
library(digest)
mpg_to_kml <- function(x) {
x * 0.425144
}
mpg_to_kml(1)
# TESTS
test_that("mpg_to_kml is defined correctly", {
expect_true(is.function(mpg_to_kml))
expect_equal(mpg_to_kml(1), 0.425144)
expect_equal(mpg_to_kml(2), 0.850288)
expect_equal(mpg_to_kml(10), 4.25144)
})
mpg_to_kml <- function(x) {
if (!is.numeric(x)) {
stop("x must be numeric")
}
x * 0.425144
}
# TESTS
test_that("mpg_to_kml throws errors for invalid input", {
expect_error(mpg_to_kml("A"))
expect_error(mpg_to_kml(list(1, 2)))
expect_error(mpg_to_kml(data.frame(x = c(1))))
})
mpg_to_kml <- function(x) {
if (!is.numeric(x)) {
stop("x must be numeric")
}
x * 0.425144
}
# TESTS
test_that("mpg_to_kml throws errors for invalid input", {
expect_error(mpg_to_kml("A"))
expect_error(mpg_to_kml(list(1, 2)))
expect_error(mpg_to_kml(data.frame(x = c(1))))
})
