x <- seq(0, 2, length.out = 500)
y <- ifelse(x <= 1, 2*x, 0)
plot(
x, y,
type = "l",
xlab = "Lecture overtime, x (minutes)",
ylab = "Conditional density",
ylim = c(0, 2)
)
